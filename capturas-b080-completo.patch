+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: npm
+          cache-dependency-path: cotacoes/package-lock.json
+      - run: npm ci
+      - name: Build com os dados na própria origem
+        run: VITE_DATA_BASE="$SMOKE_BASE_URL" npm run build
+      - name: Preparar Playwright com o Chrome já disponível no runner
+        timeout-minutes: 3
+        run: |
+          npm install --no-save playwright@1.63.0
+          google-chrome --version
+      - name: Servir o build somente em loopback
+        id: serve
+        env:
+          CAPTURE_QA_OUTPUT: ${{ runner.temp }}/qa-clipboard-capture
+        run: |
+          mkdir -p "$CAPTURE_QA_OUTPUT"
+          nohup python3 -m http.server 8768 --bind 127.0.0.1 --directory dist > "$CAPTURE_QA_OUTPUT/server.log" 2>&1 &
