diff --git a/cotacoes/scripts/capture-rgb-metrics.cjs b/cotacoes/scripts/capture-rgb-metrics.cjs
new file mode 100644
index 0000000..c114abf
--- /dev/null
+++ b/cotacoes/scripts/capture-rgb-metrics.cjs
@@ -0,0 +1,24 @@
+// Mesmo gate RGB: distância <45, sem tolerância espacial.
+module.exports = function compare({got,want,width,height,regions}) {
+  return regions.map(r=>{
+    let error=0,n=0;const colors=new Set(), histogram=new Map(), samples=[]
+    // Identifica fundo dominante da região; exige coincidência nos traços/texto,
+    // para que um PNG de fundo sólido não passe pela média de pixels.
+
+    for(let y=Math.max(0,Math.ceil(r.y));y<Math.min(height,r.y+r.h);y++)
+     for(let x=Math.max(0,Math.ceil(r.x));x<Math.min(width,r.x+r.w);x++){
+      const i=(y*width+x)*4
+      const key=[want[i]>>4,want[i+1]>>4,want[i+2]>>4].join(',')
+      colors.add(key);histogram.set(key,(histogram.get(key)||0)+1);samples.push(i)
+      for(let c=0;c<3;c++){error+=Math.abs(got[i+c]-want[i+c])/255;n++}
+     }
+    const dominant=[...histogram].sort((a,b)=>b[1]-a[1])[0][0].split(',').map(v=>Number(v)*16+8)
+    let ink=0,matched=0
+    for(const i of samples){
+      if(r.color ? Math.max(...r.color.map((v,c)=>Math.abs(want[i+c]-v)))>=45 : Math.max(...dominant.map((v,c)=>Math.abs(want[i+c]-v)))<45)continue
+      ink++
+      if(Math.max(...dominant.map((_,c)=>Math.abs(want[i+c]-got[i+c])))<45)matched++
+    }
+    return {selector:r.selector,meanError:error/n,referenceColors:colors.size,samples:n,ink,inkRecall:ink?matched/ink:0}
+  })
+}
diff --git a/cotacoes/scripts/capture-special-regions.cjs b/cotacoes/scripts/capture-special-regions.cjs
new file mode 100644
index 0000000..7cd17ce
--- /dev/null
+++ b/cotacoes/scripts/capture-special-regions.cjs
@@ -0,0 +1,20 @@
+// Avaliado no DOM original pelo Playwright; sem ignorar regiões ausentes.
+module.exports = function captureSpecialRegions(el) {
+ const root=el.getBoundingClientRect(),line=el.querySelector('svg[role="img"] path.line'),value=el.querySelector('.pct')
+ if(!line||!value)throw new Error('Diagnóstico incompleto: curva ou valor ausente.')
+ const b=line.getBoundingClientRect(),rgb=getComputedStyle(line).stroke.match(/[\d.]+/g)?.slice(0,3).map(Number)
+ if(!rgb||rgb.length!==3||rgb.some(v=>!Number.isFinite(v)))throw new Error('Diagnóstico incompleto: cor da curva não reconhecida.')
+ const result=[{selector:'curva-sem-eixos',x:b.x-root.x-2,y:b.y-root.y-2,w:b.width+4,h:b.height+4,color:rgb}]
+ for(const [name,pattern] of [['sinal',/[▲▼■]/],['digito',/\d/]]){
+  // React pode renderizar símbolo, espaço e número em Text nodes distintos.
+  const node=[...value.childNodes].find(n=>n.nodeType===3&&pattern.test(n.textContent))
+  if(!node)throw new Error('Diagnóstico incompleto: glifo de '+name+' ausente.')
+  const index=node.textContent.search(pattern)
+  if(index<0||index>=node.textContent.length)throw new Error('Diagnóstico incompleto: índice inválido de '+name)
+  const range=document.createRange();range.setStart(node,index);range.setEnd(node,index+1)
+  const rect=range.getBoundingClientRect()
+  if(!(rect.width>0&&rect.height>0))throw new Error('Diagnóstico incompleto: glifo de '+name+' sem área visível.')
+  result.push({selector:name,x:rect.x-root.x,y:rect.y-root.y,w:rect.width,h:rect.height})
+ }
+ return result
+}
